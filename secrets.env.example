# Copy to secrets.env on the VPS and fill these in. NEVER paste into chat.
NOUS_API_KEY=your_nous_key_here
GUMROAD_API_KEY=your_gumroad_key_here        # OR use POLAR below
POLAR_API_KEY=
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
GITHUB_DEPLOY_KEY_PATH=/root/.ssh/id_ed25519   # private key, public half on GitHub
HF_TOKEN=
FALLBACK_MODELS=tencent/hy3:free,another-free-model-id
